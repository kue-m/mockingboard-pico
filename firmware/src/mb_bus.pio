;
; Structure follows Oliver Schmidt's a2pico2 PIO (MIT, Copyright (c) 2022 Oliver Schmidt,
; https://github.com/oliverschmidt/a2pico), repinned and trimmed to the single /IOSEL strobe.
; The [31] settle delays are a2pico2 cycle counts at the same 200 MHz.
;

.define PIN_IOSEL 16
.define PIN_PHI0  18
.define IRQ_WRITE  4          ; pio0 internal: addr SM -> write SM handshake
.define IRQ_READ   5          ; pio0 internal: raddr SM -> table read SM handshake
.define IRQ_TICK   0          ; pio1/pio2 counter SMs: timer timed out, raised as (0 + sm_num)

; ---------------------------------------------------------------- addr
.program mb_addr
.wrap_target
idle:
    wait 1 gpio PIN_IOSEL
    wait 0 gpio PIN_IOSEL          ; our $Cn00 page is being accessed
    in pins, 10                    ; base GP8: A0-7, /IOSEL, R/W -> autopush(10)
    jmp pin idle                   ; jmp_pin = R/W, read cycle -> idle
    irq IRQ_WRITE                  ; write cycle -> wake the write SM
.wrap

% c-sdk {
static inline void mb_addr_cfg(pio_sm_config *c) {
    sm_config_set_in_pins(c, 8);               // A0 = GP8
    sm_config_set_in_shift(c, false, true, 10);
    sm_config_set_jmp_pin(c, 17);              // R/W
}
%}

; ---------------------------------------------------------------- write
; the two [31] delays (64 PIO cycles, ~350 ns at 200 MHz incl. the addr->write handoff)
; capture D0-7 unconditionally after /IOSEL falls.
.program mb_write
.wrap_target
    wait 1 irq IRQ_WRITE [31]      ; wait for + clear the write flag
    nop [31]                       ; ~64 PIO cyc: let the 6502 present D0-7
    in pins, 8                     ; base GP0: D0-7 -> autopush(8)
.wrap

% c-sdk {
static inline void mb_write_cfg(pio_sm_config *c) {
    sm_config_set_in_pins(c, 0);               // D0 = GP0
    sm_config_set_in_shift(c, false, true, 8);
}
%}

; ---------------------------------------------------------------- phi2 (cycle count)
.program mb_phi2
.wrap_target
phi2_loop:
    wait 1 gpio PIN_PHI0
    wait 0 gpio PIN_PHI0
    in y, 32
    jmp y-- phi2_loop
.wrap

% c-sdk {
static inline void mb_phi2_cfg(pio_sm_config *c) {
    sm_config_set_in_shift(c, false, true, 32);
}
%}

; ---------------------------------------------------------------- raddr (reads only)
; Pushes table base | A7 A6 A5 0 A3-A0. The 6522 does not decode A4.
.program mb_raddr
.wrap_target
idle:
    wait 1 gpio PIN_IOSEL
    wait 0 gpio PIN_IOSEL
    jmp pin read
    jmp idle
read:
    irq IRQ_READ
    mov osr, pins
    in y, 24
    out null, 5
    in osr, 3
    in null, 1
    in pins, 4
.wrap

% c-sdk {
static inline void mb_raddr_cfg(pio_sm_config *c) {
    sm_config_set_in_pins(c, 8);               // A0 = GP8
    sm_config_set_in_shift(c, false, true, 32);
    sm_config_set_out_shift(c, true, false, 32);
    sm_config_set_jmp_pin(c, 17);              // R/W
}
%}

; ---------------------------------------------------------------- read (response table)
; A byte already in the TX FIFO when the flag arrives is from an earlier read and is dropped.
.program mb_read_table
release:
    mov pindirs, null
    mov pins, null
idle:
    wait 1 irq IRQ_READ
drain:
    mov x, ~status                 ; X = 0 iff the TX FIFO is empty
    jmp !x drive
    pull noblock
    jmp drain
drive:
    mov pindirs, ~null
.wrap_target
    pull noblock
    mov pins, osr
    mov x, osr
    jmp pin release
.wrap

% c-sdk {
static inline void mb_read_table_cfg(pio_sm_config *c) {
    sm_config_set_out_pins(c, 0, 8);
    sm_config_set_jmp_pin(c, 16);              // /IOSEL
    sm_config_set_mov_status(c, STATUS_TX_LESSTHAN, 1);
}
%}

; ---------------------------------------------------------------- 6522 Timer1 counter
; Reloads the latch in both modes. The newest latch in the TX FIFO applies at the next reload.
.program mb_t1
public start:
    pull block
    mov y, osr
    pull block
    mov x, ~osr
    jmp !x enter_under             ; $FFFFFFFF = start on the $FFFF cycle
    mov x, osr
    jmp count
enter_under:
    mov x, ~null
    jmp under
newer:
    pull noblock
    jmp drain
.wrap_target
count:
    wait 1 gpio PIN_PHI0 [31]
    wait 0 gpio PIN_PHI0
    in x, 32
    mov isr, x
    mov osr, y
drain:
    mov x, status                  ; X = 0 iff a latch is waiting in the TX FIFO
    jmp !x newer
    mov y, osr
    mov x, isr
    jmp x-- count
under:
    wait 1 gpio PIN_PHI0 [31]
    wait 0 gpio PIN_PHI0
    in x, 32
    irq IRQ_TICK rel
    mov x, y
.wrap

% c-sdk {
static inline void mb_t1_cfg(pio_sm_config *c) {
    sm_config_set_in_shift(c, false, true, 32);
    sm_config_set_mov_status(c, STATUS_TX_LESSTHAN, 1);
}
%}

; ---------------------------------------------------------------- 6522 Timer2 counter
; There is no reload. X is 32 bits, so it reaches 0 again only after 2^32 cycles.
.program mb_t2
public start:
    pull block
    mov x, ~osr
    jmp !x enter_under
    mov x, osr
    jmp count
enter_under:
    mov x, ~null
    jmp under
.wrap_target
count:
    wait 1 gpio PIN_PHI0 [31]
    wait 0 gpio PIN_PHI0
    in x, 32
    jmp x-- count
under:
    wait 1 gpio PIN_PHI0 [31]
    wait 0 gpio PIN_PHI0
    in x, 32
    irq IRQ_TICK rel
    jmp x-- count
.wrap

% c-sdk {
static inline void mb_t2_cfg(pio_sm_config *c) {
    sm_config_set_in_shift(c, false, true, 32);
}
%}
